         .. matrix-row::
            :header:

            .. matrix-cell:: Deployment

            .. matrix-cell:: Compute partition mode

            .. matrix-cell:: Memory partition mode

{% for group in ns_pt.groups %}
{% for entry in group.entries %}
         .. matrix-row::
            :show-cond: {{ gpu_slugs(group.gpus) }}

            .. matrix-cell:: KVM Passthrough

            .. matrix-cell:: {{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}

            .. matrix-cell:: {{ entry.memory }}

{% endfor %}
{% endfor %}
{% for group in ns_ep.groups %}
{% for entry in group.entries %}
         .. matrix-row::
            :show-cond: {{ gpu_slugs(group.gpus) }}

            .. matrix-cell:: ESXi Passthrough

            .. matrix-cell:: {{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}

            .. matrix-cell:: {{ entry.memory }}

{% endfor %}
{% endfor %}
{% endif %}
{%- set ns_fn = namespace(needed=false, mv_gpu_names=[]) -%}
{%- set sriov_slugs = gpu_slugs(ks_gpu_names + es_gpu_names) -%}
{% if ns_ks.groups | length > 0 or ns_es.groups | length > 0 %}
   .. selected:: {{ sriov_slugs }}

      The following configurations are available on AMD Instinct GPUs in SR-IOV
      deployments. See :ref:`release-virtualization-support` for driver support
      information.

      .. matrix::

         .. matrix-row::
            :header:

            .. matrix-cell:: Deployment

            .. matrix-cell:: VFs per GPU

            .. matrix-cell:: Compute partition mode

            .. matrix-cell:: Memory partition mode

{% for group in ns_ks.groups %}
{% for entry in group.entries %}
{%- set is_list = entry.vfs is iterable and entry.vfs is not string and entry.vfs is not number -%}
{%- set multi_vf = is_list or (entry.vfs is number and entry.vfs > 1) -%}
{%- if multi_vf -%}
{%- set ns_fn.needed = true -%}
{%- for gname in group.gpus -%}
{%- if gname not in ns_fn.mv_gpu_names -%}
{%- set ns_fn.mv_gpu_names = ns_fn.mv_gpu_names + [gname] -%}
{%- endif -%}
{%- endfor -%}
{%- endif %}
         .. matrix-row::
            :show-cond: {{ gpu_slugs(group.gpus) }}

            .. matrix-cell:: KVM SR-IOV

            .. matrix-cell::{% if not multi_vf %} {{ vfs_display(entry) | trim }}{% endif %}
{% if multi_vf %}
               {{ vfs_display(entry) | trim }} :ref:`[*] <sriov-multi-vf-note>`
{% endif %}

            .. matrix-cell:: {{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}

            .. matrix-cell:: {{ entry.memory }}

{% endfor %}
{% endfor %}
