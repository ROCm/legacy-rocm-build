            :show-cond: {{ gpu_slugs(group.gpus) }}

            .. matrix-cell:: {{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}

            .. matrix-cell:: {{ entry.memory }}

{% endfor %}
{% endfor %}
{% endif %}
{% if ns_pt.groups | length > 0 or ns_ep.groups | length > 0 %}
