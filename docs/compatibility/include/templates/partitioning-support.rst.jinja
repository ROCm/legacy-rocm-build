    {%- else -%}
      {%- set _ = ns_pt.groups.append({"gpus": [name], "entries": entries}) -%}
    {%- endif -%}
    {%- set ns_pt.prev_key = k -%}
    {%- set ns_pt.prev_idx = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}

{#---------------------------------------------------------------------------
  Build esxi-passthrough merged groups and collect slugs.
---------------------------------------------------------------------------#}
{%- set ns_ep = namespace(groups=[], prev_key="", prev_idx=-1) -%}
{%- set ep_gpu_names = [] -%}
{%- for name in gpu_names -%}
  {%- if instinct[name]["esxi-passthrough"] is defined -%}
    {%- set _ = ep_gpu_names.append(name) -%}
    {%- set entries = instinct[name]["esxi-passthrough"] -%}
    {%- set k = configs_key(entries) | trim -%}
    {%- if k == ns_ep.prev_key and ns_ep.prev_idx >= 0 -%}
      {%- set last = ns_ep.groups[-1] -%}
      {%- set _ = ns_ep.groups.pop() -%}
      {%- set _ = ns_ep.groups.append({"gpus": last.gpus + [name], "entries": last.entries}) -%}
    {%- else -%}
      {%- set _ = ns_ep.groups.append({"gpus": [name], "entries": entries}) -%}
    {%- endif -%}
    {%- set ns_ep.prev_key = k -%}
    {%- set ns_ep.prev_idx = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{#-- pt_slugs gates the whole section: any GPU with either passthrough type --#}
{%- set pt_slugs = gpu_slugs(pt_gpu_names + ep_gpu_names) -%}

{#---------------------------------------------------------------------------
  Build kvm-sriov merged groups and collect slugs for kvm-sriov GPUs.
---------------------------------------------------------------------------#}
{%- set ns_ks = namespace(groups=[], prev_key="", prev_idx=-1) -%}
{%- set ks_gpu_names = [] -%}
{%- for name in gpu_names -%}
