{#
  Template: partitioning-support-table.md.jinja
  Renders the two partitioning support tables (bare-metal and KVM SR-IOV).
  Output: MyST markup with HTML tables inside {raw} html fences.

  Primary data: partitioning-support.yaml (passed as `data` by the caller)

  Bare-metal table columns:  Deployment | Device | Compute partition mode | Memory partition mode
  Passthrough table columns:  Deployment | Device | Compute partition mode | Memory partition mode
  KVM SR-IOV table columns:  Deployment | Device | VFs per GPU | Compute partition mode | Memory partition mode

  Device merging: consecutive GPUs with identical configurations are merged
  into a single device cell showing combined names (e.g. "Instinct MI355X, MI350X").

  VFs rendering:
    - scalar   → displayed as-is (e.g. "1", "8")
    - list     → joined with " or " (e.g. "1 or 8")
  If default: true, "(Default)" is appended to the compute mode label.
#}
{%- set instinct = data["AMD Instinct"] -%}

{#---------------------------------------------------------------------------
  config_key(entry)
  Returns a string key for a bare-metal or kvm-sriov entry for comparison.
---------------------------------------------------------------------------#}
{%- macro config_key(entry) -%}
{{ entry.compute }}|||{{ entry.memory }}{% if entry.vfs is defined %}|||{{ entry.vfs | string }}{% endif %}{% if entry.default is defined %}|||default{% endif %}
{%- endmacro -%}

{#---------------------------------------------------------------------------
  configs_key(entries)
  Returns a string key for a full list of entries.
---------------------------------------------------------------------------#}
{%- macro configs_key(entries) -%}
{%- for e in entries %}{{ config_key(e) | trim }}~~~{%- endfor -%}
{%- endmacro -%}

{#---------------------------------------------------------------------------
  vfs_display(entry)
  Returns the display string for the VFs column.
---------------------------------------------------------------------------#}
{%- macro vfs_display(entry) -%}
{%- if entry.vfs is iterable and entry.vfs is not string and entry.vfs is not number -%}
{{ entry.vfs | join(" or ") }}
{%- else -%}
{{ entry.vfs }}
{%- endif -%}
{%- endmacro -%}

{#---------------------------------------------------------------------------
  build_merged_groups(section_key)
  Builds a list of merged device groups for a given section (bare-metal or kvm-sriov).
  Each group: {names: [list of short GPU names], entries: [config entries]}
---------------------------------------------------------------------------#}
{%- macro render_bare_metal() -%}
{#-- Collect GPUs that have bare-metal entries --#}
{%- set bm_gpus = [] -%}
{%- for gpu_name, gpu in instinct.items() -%}
  {%- if gpu["bare-metal"] is defined -%}
    {%- set short = gpu_name | replace("AMD Instinct ", "Instinct ") -%}
    {%- set _ = bm_gpus.append({"name": short, "entries": gpu["bare-metal"]}) -%}
  {%- endif -%}
{%- endfor -%}

{#-- Merge consecutive GPUs with identical configs --#}
{%- set groups = [] -%}
{%- set ns = namespace(prev_key="", prev_idx=-1) -%}
{%- for gpu in bm_gpus -%}
  {%- set k = configs_key(gpu.entries) | trim -%}
  {%- if k == ns.prev_key and ns.prev_idx >= 0 -%}
    {#- Same as previous: append name to existing group -#}
    {%- set last = groups[-1] -%}
    {%- set new_names = last.names + [gpu.name] -%}
    {%- set _ = groups.pop() -%}
    {%- set _ = groups.append({"names": new_names, "entries": last.entries}) -%}
  {%- else -%}
    {%- set _ = groups.append({"names": [gpu.name], "entries": gpu.entries}) -%}
  {%- endif -%}
  {%- set ns.prev_key = k -%}
  {%- set ns.prev_idx = loop.index0 -%}
{%- endfor -%}

{#-- Compute total rows (sum of entries across all groups) --#}
{%- set ns_total = namespace(n=0) -%}
{%- for g in groups -%}{%- set ns_total.n = ns_total.n + (g.entries | length) -%}{%- endfor -%}

<table class="rocm-docs-table table">
  <thead>
    <tr>
      <th class="head"><p>Deployment</p></th>
      <th class="head"><p>Device</p></th>
      <th class="head"><p>Compute partition mode</p></th>
      <th class="head"><p>Memory partition mode</p></th>
    </tr>
  </thead>
  <tbody>
{%- set g_first = namespace(deploy_written=false) -%}
{%- for group in groups %}
{%- set n_rows = group.entries | length %}
{%- set dev_label = group.names | join(", ") %}
{%- for entry in group.entries %}
    <tr>
{%- if not g_first.deploy_written %}
      <td rowspan="{{ ns_total.n }}" style="vertical-align: middle;"><p>Bare metal</p></td>
{%- set g_first.deploy_written = true %}
{%- endif %}
{%- if loop.first %}
      <td{% if n_rows > 1 %} rowspan="{{ n_rows }}" style="vertical-align: middle;"{% endif %}><p>{{ dev_label }}</p></td>
{%- endif %}
      <td><p>{{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}</p></td>
      <td><p>{{ entry.memory }}</p></td>
    </tr>
{%- endfor %}
{%- endfor %}
  </tbody>
</table>
{%- endmacro -%}

{%- macro render_passthrough() -%}
{#-- KVM Passthrough --#}
{%- set kvm_gpus = [] -%}
{%- for gpu_name, gpu in instinct.items() -%}
  {%- if gpu["passthrough"] is defined -%}
    {%- set short = gpu_name | replace("AMD Instinct ", "Instinct ") -%}
    {%- set _ = kvm_gpus.append({"name": short, "entries": gpu["passthrough"]}) -%}
  {%- endif -%}
{%- endfor -%}
{%- set kvm_groups = [] -%}
{%- set ns = namespace(prev_key="", prev_idx=-1) -%}
{%- for gpu in kvm_gpus -%}
  {%- set k = configs_key(gpu.entries) | trim -%}
  {%- if k == ns.prev_key and ns.prev_idx >= 0 -%}
    {%- set last = kvm_groups[-1] -%}
    {%- set _ = kvm_groups.pop() -%}
    {%- set _ = kvm_groups.append({"names": last.names + [gpu.name], "entries": last.entries}) -%}
  {%- else -%}
    {%- set _ = kvm_groups.append({"names": [gpu.name], "entries": gpu.entries}) -%}
  {%- endif -%}
  {%- set ns.prev_key = k -%}
  {%- set ns.prev_idx = loop.index0 -%}
{%- endfor -%}
{%- set ns_kvm = namespace(n=0) -%}
{%- for g in kvm_groups -%}{%- set ns_kvm.n = ns_kvm.n + (g.entries | length) -%}{%- endfor -%}

{#-- ESXi Passthrough --#}
{%- set esxi_gpus = [] -%}
{%- for gpu_name, gpu in instinct.items() -%}
  {%- if gpu["esxi-passthrough"] is defined -%}
    {%- set short = gpu_name | replace("AMD Instinct ", "Instinct ") -%}
    {%- set _ = esxi_gpus.append({"name": short, "entries": gpu["esxi-passthrough"]}) -%}
  {%- endif -%}
{%- endfor -%}
{%- set esxi_groups = [] -%}
{%- set ns2 = namespace(prev_key="", prev_idx=-1) -%}
{%- for gpu in esxi_gpus -%}
  {%- set k = configs_key(gpu.entries) | trim -%}
  {%- if k == ns2.prev_key and ns2.prev_idx >= 0 -%}
    {%- set last = esxi_groups[-1] -%}
    {%- set _ = esxi_groups.pop() -%}
    {%- set _ = esxi_groups.append({"names": last.names + [gpu.name], "entries": last.entries}) -%}
  {%- else -%}
    {%- set _ = esxi_groups.append({"names": [gpu.name], "entries": gpu.entries}) -%}
  {%- endif -%}
  {%- set ns2.prev_key = k -%}
  {%- set ns2.prev_idx = loop.index0 -%}
{%- endfor -%}
{%- set ns_esxi = namespace(n=0) -%}
{%- for g in esxi_groups -%}{%- set ns_esxi.n = ns_esxi.n + (g.entries | length) -%}{%- endfor -%}

<table class="rocm-docs-table table">
  <thead>
    <tr>
      <th class="head"><p>Deployment</p></th>
      <th class="head"><p>Device</p></th>
      <th class="head"><p>Compute partition mode</p></th>
      <th class="head"><p>Memory partition mode</p></th>
    </tr>
  </thead>
  <tbody>
{#-- KVM Passthrough rows --#}
{%- set kvm_first = namespace(deploy_written=false) -%}
{%- for group in kvm_groups %}
{%- set n_rows = group.entries | length %}
{%- set dev_label = group.names | join(", ") %}
{%- for entry in group.entries %}
    <tr>
{%- if not kvm_first.deploy_written %}
      <td rowspan="{{ ns_kvm.n }}" style="vertical-align: middle;"><p>KVM Passthrough</p></td>
{%- set kvm_first.deploy_written = true %}
{%- endif %}
{%- if loop.first %}
      <td{% if n_rows > 1 %} rowspan="{{ n_rows }}" style="vertical-align: middle;"{% endif %}><p>{{ dev_label }}</p></td>
{%- endif %}
      <td><p>{{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}</p></td>
      <td><p>{{ entry.memory }}</p></td>
    </tr>
{%- endfor %}
{%- endfor %}
{#-- ESXi Passthrough rows --#}
{%- set esxi_first = namespace(deploy_written=false) -%}
{%- for group in esxi_groups %}
{%- set n_rows = group.entries | length %}
{%- set dev_label = group.names | join(", ") %}
{%- for entry in group.entries %}
    <tr>
{%- if not esxi_first.deploy_written %}
      <td rowspan="{{ ns_esxi.n }}" style="vertical-align: middle;"><p>ESXi Passthrough</p></td>
{%- set esxi_first.deploy_written = true %}
{%- endif %}
{%- if loop.first %}
      <td{% if n_rows > 1 %} rowspan="{{ n_rows }}" style="vertical-align: middle;"{% endif %}><p>{{ dev_label }}</p></td>
{%- endif %}
      <td><p>{{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}</p></td>
      <td><p>{{ entry.memory }}</p></td>
    </tr>
{%- endfor %}
{%- endfor %}
  </tbody>
</table>
{%- endmacro -%}

{%- macro render_sriov(section_key, label) -%}
{#-- Collect GPUs that have entries for this section --#}
{%- set sr_gpus = [] -%}
{%- for gpu_name, gpu in instinct.items() -%}
  {%- if gpu[section_key] is defined -%}
    {%- set short = gpu_name | replace("AMD Instinct ", "Instinct ") -%}
    {%- set _ = sr_gpus.append({"name": short, "entries": gpu[section_key]}) -%}
  {%- endif -%}
{%- endfor -%}

{#-- Merge consecutive GPUs with identical configs --#}
{%- set groups = [] -%}
{%- set ns = namespace(prev_key="", prev_idx=-1) -%}
{%- for gpu in sr_gpus -%}
  {%- set k = configs_key(gpu.entries) | trim -%}
  {%- if k == ns.prev_key and ns.prev_idx >= 0 -%}
    {%- set last = groups[-1] -%}
    {%- set new_names = last.names + [gpu.name] -%}
    {%- set _ = groups.pop() -%}
    {%- set _ = groups.append({"names": new_names, "entries": last.entries}) -%}
  {%- else -%}
    {%- set _ = groups.append({"names": [gpu.name], "entries": gpu.entries}) -%}
  {%- endif -%}
  {%- set ns.prev_key = k -%}
  {%- set ns.prev_idx = loop.index0 -%}
{%- endfor -%}

{#-- Compute total rows --#}
{%- set ns_total = namespace(n=0) -%}
{%- for g in groups -%}{%- set ns_total.n = ns_total.n + (g.entries | length) -%}{%- endfor -%}

{#-- Track whether any row emits a footnote marker --#}
{%- set ns_fn = namespace(needed=false, count=0) -%}

<table class="rocm-docs-table table">
  <thead>
    <tr>
      <th class="head"><p>Deployment</p></th>
      <th class="head"><p>Device</p></th>
      <th class="head"><p>VFs per GPU</p></th>
      <th class="head"><p>Compute partition mode</p></th>
      <th class="head"><p>Memory partition mode</p></th>
    </tr>
  </thead>
  <tbody>
{%- set g_first = namespace(deploy_written=false) -%}
{%- for group in groups %}
{%- set n_rows = group.entries | length %}
{%- set dev_label = group.names | join(", ") %}
{%- for entry in group.entries %}
{%- set is_list = entry.vfs is iterable and entry.vfs is not string and entry.vfs is not number %}
{%- set multi_vf = is_list or (entry.vfs is number and entry.vfs > 1) %}
{%- if multi_vf %}{%- set ns_fn.needed = true %}{%- set ns_fn.count = ns_fn.count + 1 %}{%- endif %}
    <tr>
{%- if not g_first.deploy_written %}
      <td rowspan="{{ ns_total.n }}" style="vertical-align: middle;"><p>{{ label }}</p></td>
{%- set g_first.deploy_written = true %}
{%- endif %}
{%- if loop.first %}
      <td{% if n_rows > 1 %} rowspan="{{ n_rows }}" style="vertical-align: middle;"{% endif %}><p>{{ dev_label }}</p></td>
{%- endif %}
      <td><p>{{ vfs_display(entry) | trim }}{% if multi_vf %}<a id="{{ section_key }}-fn-ref-{{ ns_fn.count }}" class="footnote-reference brackets" href="#partitioning-support-{{ section_key }}-footnotes" role="doc-noteref"><span class="fn-bracket">[</span>*<span class="fn-bracket">]</span></a>{% endif %}</p></td>
      <td><p>{{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}</p></td>
      <td><p>{{ entry.memory }}</p></td>
    </tr>
{%- endfor %}
{%- endfor %}
  </tbody>
</table>
{%- if ns_fn.needed %}
<aside class="footnote brackets" id="partitioning-support-{{ section_key }}-footnotes" role="doc-footnote">
<span class="label"><span class="fn-bracket">[</span>*<span class="fn-bracket">]</span></span>
<span class="backrefs">({% for i in range(1, ns_fn.count + 1) %}<a role="doc-backlink" href="#{{ section_key }}-fn-ref-{{ i }}">{{ i }}</a>{% if not loop.last %}, {% endif %}{% endfor %})</span>
<p>Multi-VF support requires a compatible firmware. See <a href="#kernel-driver-and-firmware-bundle-support">Kernel driver and firmware bundle support</a> for the list of required firmware versions and supported configurations.</p>
</aside>
{%- endif %}
{%- endmacro -%}

{%- macro render_sriov_combined(sections) -%}
{#-- Build merged groups for every section up front so rowspans are known --#}
{%- set all_sections = [] -%}
{%- for sec in sections -%}
  {%- set sr_gpus = [] -%}
  {%- for gpu_name, gpu in instinct.items() -%}
    {%- if gpu[sec[0]] is defined -%}
      {%- set short = gpu_name | replace("AMD Instinct ", "Instinct ") -%}
      {%- set _ = sr_gpus.append({"name": short, "entries": gpu[sec[0]]}) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set groups = [] -%}
  {%- set ns = namespace(prev_key="", prev_idx=-1) -%}
  {%- for gpu in sr_gpus -%}
    {%- set k = configs_key(gpu.entries) | trim -%}
    {%- if k == ns.prev_key and ns.prev_idx >= 0 -%}
      {%- set last = groups[-1] -%}
      {%- set new_names = last.names + [gpu.name] -%}
      {%- set _ = groups.pop() -%}
      {%- set _ = groups.append({"names": new_names, "entries": last.entries}) -%}
    {%- else -%}
      {%- set _ = groups.append({"names": [gpu.name], "entries": gpu.entries}) -%}
    {%- endif -%}
    {%- set ns.prev_key = k -%}
    {%- set ns.prev_idx = loop.index0 -%}
  {%- endfor -%}
  {%- set ns_rows = namespace(n=0) -%}
  {%- for g in groups -%}{%- set ns_rows.n = ns_rows.n + (g.entries | length) -%}{%- endfor -%}
  {%- set _ = all_sections.append({"label": sec[1], "groups": groups, "total": ns_rows.n}) -%}
{%- endfor -%}
{%- set ns_fn = namespace(needed=false, count=0) -%}
<table class="rocm-docs-table table">
  <thead>
    <tr>
      <th class="head"><p>Deployment</p></th>
      <th class="head"><p>Device</p></th>
      <th class="head"><p>VFs per GPU</p></th>
      <th class="head"><p>Compute partition mode</p></th>
      <th class="head"><p>Memory partition mode</p></th>
    </tr>
  </thead>
  <tbody>
{%- for sec in all_sections %}
{%- set g_first = namespace(deploy_written=false) %}
{%- for group in sec.groups %}
{%- set n_rows = group.entries | length %}
{%- set dev_label = group.names | join(", ") %}
{%- for entry in group.entries %}
{%- set is_list = entry.vfs is iterable and entry.vfs is not string and entry.vfs is not number %}
{%- set multi_vf = is_list or (entry.vfs is number and entry.vfs > 1) %}
{%- if multi_vf %}{%- set ns_fn.needed = true %}{%- set ns_fn.count = ns_fn.count + 1 %}{%- endif %}
    <tr>
{%- if not g_first.deploy_written %}
      <td rowspan="{{ sec.total }}" style="vertical-align: middle;"><p>{{ sec.label }}</p></td>
{%- set g_first.deploy_written = true %}
{%- endif %}
{%- if loop.first %}
      <td{% if n_rows > 1 %} rowspan="{{ n_rows }}" style="vertical-align: middle;"{% endif %}><p>{{ dev_label }}</p></td>
{%- endif %}
      <td><p>{{ vfs_display(entry) | trim }}{% if multi_vf %}<a id="sriov-fn-ref-{{ ns_fn.count }}" class="footnote-reference brackets" href="#partitioning-support-sriov-footnotes" role="doc-noteref"><span class="fn-bracket">[</span>*<span class="fn-bracket">]</span></a>{% endif %}</p></td>
      <td><p>{{ entry.compute }}{% if entry.default is defined and entry.default %} (Default){% endif %}</p></td>
      <td><p>{{ entry.memory }}</p></td>
    </tr>
{%- endfor %}
{%- endfor %}
{%- endfor %}
  </tbody>
</table>
{%- if ns_fn.needed %}
<aside class="footnote brackets" id="partitioning-support-sriov-footnotes" role="doc-footnote">
<span class="label"><span class="fn-bracket">[</span>*<span class="fn-bracket">]</span></span>
<span class="backrefs">({% for i in range(1, ns_fn.count + 1) %}<a role="doc-backlink" href="#sriov-fn-ref-{{ i }}">{{ i }}</a>{% if not loop.last %}, {% endif %}{% endfor %})</span>
<p>Multi-VF support requires a compatible firmware. See <a href="#kernel-driver-and-firmware-bundle-support">Kernel driver and firmware bundle support</a> for the list of required firmware versions and supported configurations.</p>
</aside>
{%- endif %}
{%- endmacro -%}

The following compute partition and NUMA-per-socket (NPS) configurations are
available on AMD Instinct GPUs in bare-metal deployments.

```{raw} html
{{ render_bare_metal() }}
```

The following configurations are available on AMD Instinct GPUs in passthrough
deployments.
```{raw} html
{{ render_passthrough() }}
```

The following configurations are available on AMD Instinct GPUs in SR-IOV
deployments. See {ref}`release-virtualization-support` for driver support
information.

```{raw} html
{{ render_sriov_combined([["kvm-sriov", "KVM SR-IOV"], ["esxi-sriov", "ESXi SR-IOV"]]) }}
```
