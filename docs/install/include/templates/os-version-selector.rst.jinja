{% for fam_name in data.keys() if not fam_name.startswith("_") %}
{%- set family_os = os_data[fam_name] -%}
{%- set fam_slug = fam_name | replace("AMD ", "") | lower -%}
{%- set ns = namespace(seen=[], wsl_vers=[]) -%}
{%- for gpu_name in data[fam_name].keys() -%}
  {%- if gpu_name in family_os and "WSL2" in family_os[gpu_name] -%}
    {%- for v in family_os[gpu_name]["WSL2"]["versions"] -%}
      {%- if v not in ns.seen -%}
        {%- set _ = ns.wsl_vers.append(v) -%}
        {%- set ns.seen = ns.seen + [v] -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.wsl_vers | length > 0 -%}
{%- set w = col_width(ns.wsl_vers | length) %}
{% for ver in ns.wsl_vers %}
      .. selector-option:: Ubuntu {{ ver }}
         :show-cond: fam={{ fam_slug }}
         :value: {{ ver }}
         :width: {{ w }}
{% endfor %}
{%- endif %}
{%- endfor %}
